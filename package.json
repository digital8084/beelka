{
  "name": "beelka-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Beelka public travel and digital services platform",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/unit/*.test.ts tests/api/*.test.ts tests/integration/*.test.ts && node --check tools/identity-platform-smoke/app.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "start": "node dist/apps/api/src/main.js",
    "worker:dev": "npx wrangler dev --config wrangler.jsonc",
    "worker:deploy": "npx wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
