# Copy to .env for local development only. Never commit actual secrets.
NODE_ENV=development
PORT=8080
BEELKA_MODE=simulation
MMBC_LIVE_ENABLED=false
PAYMENT_GATEWAY_MODE=simulation

# Optional: enables Google Identity Platform/Firebase ID-token verification.
# Runtime also needs Google Application Default Credentials (ADC).
# Prefer workload identity on Google Cloud; configure ADC separately for local use.
# GOOGLE_CLOUD_PROJECT=your-identity-platform-project-id
# Or use FIREBASE_PROJECT_ID=your-identity-platform-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json (never commit that file)

# Exact browser origins allowed to call API with CORS; comma-separated, no paths or wildcards.
# For the local Identity Platform smoke page only:
# BEELKA_CORS_ORIGINS=http://localhost:4173

# Set true only for local demo-order development. Production will reject this flag.
BEELKA_DEMO_ORDERS_ENABLED=false

# Local development may use one local role for convenience.
# Staging/production must use a non-superuser runtime role here.
DATABASE_URL=postgresql://beelka:beelka_local_only@localhost:5432/beelka
DATABASE_SSL=false

# Optional local override; required for staging/production role separation.
# The role should own schema objects and be separate from DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://beelka_migrator:replace_me@localhost:5432/beelka
# MIGRATION_DATABASE_SSL=false
