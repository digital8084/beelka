# Copy to .env for local development only. Never commit actual secrets.
NODE_ENV=development
PORT=8080
BEELKA_MODE=simulation
MMBC_LIVE_ENABLED=false
PAYMENT_GATEWAY_MODE=simulation

# Set true only for local demo-order development. Production will reject this flag.
BEELKA_DEMO_ORDERS_ENABLED=false

DATABASE_URL=postgresql://beelka:beelka_local_only@localhost:5432/beelka
DATABASE_SSL=false
