# Local-only sample. Never place production credentials in this file.
NODE_ENV=development
PORT=8080
BEELKA_MODE=simulation
MMBC_LIVE_ENABLED=false
PAYMENT_GATEWAY_MODE=simulation

# Optional for liveness-only local run. /readyz remains not-ready without DB.
DATABASE_URL=postgresql://beelka:beelka_local_only@localhost:5432/beelka
DATABASE_SSL=false
